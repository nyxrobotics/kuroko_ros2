<?xml version="1.0"?>
<package format="3">
  <name>kuroko_isaac_config_generator</name>
  <version>0.1.0</version>
  <description>Generate SDF (via xacro + gz) and optionally export to USD/USDA for Isaac Lab.</description>

  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Optional, but valid in Humble/Jammy and helps dev environments -->
  <build_depend>sdformat12</build_depend>
  <exec_depend>sdformat12</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
