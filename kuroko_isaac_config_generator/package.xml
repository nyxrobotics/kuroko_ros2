<?xml version="1.0"?>
<package format="3">
  <name>kuroko_isaac_config_generator</name>
  <version>0.0.0</version>
  <description>Kuroko Isaac Lab config generator.</description>
  <maintainer email="nyx@example.com">nyx</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>python3-ament-index-python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <!-- We rely on CLI tools: xacro and gz -->
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
