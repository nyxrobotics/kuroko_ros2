<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Reuse helper macros from sibling files -->
  <xacro:include filename="gazebo_ros2_transmission.xacro"/>
  <xacro:include filename="gazebo_ros2_control_system.xacro"/>

  <!--
    Gazebo Classic ros2_control plugin wrapper.

    Args:
      controller_yaml: path to a ros2_control controller YAML file.

    This macro:
      - Loads controller_yaml
      - Picks the first controller under controller_manager.ros__parameters
      - Extracts joints and (best-effort) infers command interface
      - Emits:
          * <ros2_control> system block
          * <transmission> blocks (via gazebo_ros2_transmission.xacro)
          * <gazebo> plugin with <parameters> pointing to controller_yaml
  -->
  <xacro:macro name="gazebo_ros2_control_plugin" params="controller_yaml">

    <xacro:property name="_cfg" value="${xacro.load_yaml(controller_yaml)}" />
    <xacro:property name="_cm_params"
                    value="${_cfg.get('controller_manager', dict()).get('ros__parameters', dict())}" />

    <!-- Choose the first controller entry (skip update_rate if present) -->
    <xacro:property name="_ctrl_name"
                    value="${[k for k in _cm_params.keys() if k != 'update_rate'][0] if len([k for k in _cm_params.keys() if k != 'update_rate']) > 0 else ''}" />

    <xacro:property name="_ctrl_cfg" value="${_cm_params.get(_ctrl_name, dict())}" />
    <xacro:property name="_ctrl_type" value="${_ctrl_cfg.get('type', '')}" />
    <xacro:property name="_joints" value="${_ctrl_cfg.get('joints', [])}" />
    <xacro:property name="_cmd_ifs" value="${_ctrl_cfg.get('command_interfaces', [])}" />
    <xacro:property name="_iface_name" value="${_ctrl_cfg.get('interface_name', '')}" />

    <!-- Infer command interface (position/velocity/effort) -->
    <xacro:property name="_is_forward"
                    value="${('ForwardCommandController' in _ctrl_type) or ('forward_command_controller' in _ctrl_type)}" />

    <xacro:property name="_cmd_if_from_cmd_ifs"
                    value="${
                      ('effort' if ('effort' in _cmd_ifs) else
                       ('position' if ('position' in _cmd_ifs) else
                        ('velocity' if ('velocity' in _cmd_ifs) else
                         (_cmd_ifs[0] if _cmd_ifs else 'position')
                        )
                       )
                      )
                    }" />

    <xacro:property name="_cmd_if_from_iface_name"
                    value="${
                      ('effort' if ('effort' in _iface_name) else
                       ('position' if ('position' in _iface_name) else
                        ('velocity' if ('velocity' in _iface_name) else
                         (_iface_name if _iface_name else 'position')
                        )
                       )
                      )
                    }" />

    <xacro:property name="_cmd_if"
                    value="${_cmd_if_from_iface_name if _is_forward else _cmd_if_from_cmd_ifs}" />

    <!-- ros2_control joint entry -->
    <xacro:macro name="_ros2_control_joint" params="joint_name cmd_if">
      <joint name="${joint_name}">
        <command_interface name="${cmd_if}"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <!-- Recursive loop for ros2_control joint entries -->
    <xacro:macro name="_ros2_control_joint_loop" params="joints cmd_if">
      <xacro:if value="${len(joints) > 0}">
        <xacro:_ros2_control_joint joint_name="${joints[0]}" cmd_if="${cmd_if}"/>
        <xacro:_ros2_control_joint_loop joints="${joints[1:]}" cmd_if="${cmd_if}"/>
      </xacro:if>
    </xacro:macro>

    <!-- ros2_control block -->
    <xacro:gazebo_ros2_control_system/>

    <!-- transmissions -->
    <xacro:if value="${_cmd_if == 'effort'}">
      <xacro:set_effort_interfaces joints="${_joints}"/>
    </xacro:if>
    <xacro:if value="${_cmd_if == 'velocity'}">
      <xacro:set_velocity_interfaces joints="${_joints}"/>
    </xacro:if>
    <xacro:if value="${_cmd_if == 'position'}">
      <xacro:set_position_interfaces joints="${_joints}"/>
    </xacro:if>

    <!-- Gazebo Classic plugin -->
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>${controller_yaml}</parameters>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>