<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo Classic gazebo_ros2_control helper (restricted xacro eval safe)

    Constraints handled:
      - no xacro:for
      - no isinstance()
      - no next()
      - NO dict literal {} anywhere (use dict())
      - keep expressions simple

    Params:
      - enabled: bool
      - controller: controller instance name (e.g. joint_trajectory_controller)
      - yaml_files: semicolon-separated list of YAML file paths (absolute paths recommended)
      - command_interface: optional override; empty => infer
      - debug: xacro-time messages
  -->

  <xacro:macro name="gazebo_ros2_control_plugin"
               params="enabled
                       controller:=''
                       yaml_files:=''
                       command_interface:=''
                       debug:=false
                       ros2_control_name:=GazeboSystem
                       robot_param:=robot_description
                       robot_param_node:=robot_state_publisher">

    <!-- Split YAML list -->
    <xacro:property name="_yaml_list"
                    value="${[s for s in yaml_files.split(';') if s.strip()]}" />

    <!-- Load YAMLs -->
    <xacro:property name="_cfg_list"
                    value="${[xacro.load_yaml(p) for p in _yaml_list]}" />

    <!-- Layout B candidates: controller_manager.ros__parameters[controller] -->
    <xacro:property name="_cm_candidates"
                    value="${[
                      cfg.get('controller_manager', dict()).get('ros__parameters', dict()).get(controller, None)
                      for cfg in _cfg_list
                    ]}" />

    <!-- Layout A candidates: cfg[controller].ros__parameters -->
    <xacro:property name="_direct_candidates"
                    value="${[
                      cfg.get(controller, dict()).get('ros__parameters', None)
                      for cfg in _cfg_list
                    ]}" />

    <!-- Pick controller config dict (no next/len; no {} literal) -->
    <xacro:property name="_ctrl_cfg_cm"
                    value="${([c for c in _cm_candidates if c is not None] + [dict()])[0]}" />

    <xacro:property name="_ctrl_cfg_direct"
                    value="${([c for c in _direct_candidates if c is not None] + [dict()])[0]}" />

    <xacro:property name="_ctrl_cfg"
                    value="${_ctrl_cfg_cm if _ctrl_cfg_cm else _ctrl_cfg_direct}" />

    <!-- Extract fields -->
    <xacro:property name="_ctrl_type" value="${_ctrl_cfg.get('type', '')}" />
    <xacro:property name="_joints" value="${_ctrl_cfg.get('joints', [])}" />
    <xacro:property name="_cmd_ifs" value="${_ctrl_cfg.get('command_interfaces', [])}" />
    <xacro:property name="_iface_name" value="${_ctrl_cfg.get('interface_name', '')}" />

    <!-- Resolve command interface -->
    <xacro:property name="_cmd_if"
                    value="${
                      command_interface if command_interface else
                      (
                        (
                          'effort' if ('effort' in _cmd_ifs) else
                          ('position' if ('position' in _cmd_ifs) else
                           ('velocity' if ('velocity' in _cmd_ifs) else
                            (_cmd_ifs[0] if _cmd_ifs else 'position')
                           )
                          )
                        )
                        if _cmd_ifs else
                        (
                          (
                            'effort' if ('effort' in _iface_name) else
                            ('position' if ('position' in _iface_name) else
                             ('velocity' if ('velocity' in _iface_name) else
                              (_iface_name if _iface_name else 'position')
                             )
                            )
                          )
                          if _iface_name else
                          (
                            'position' if ('JointGroupPositionController' in _ctrl_type) else
                            ('effort' if ('JointGroupEffortController' in _ctrl_type) else
                             'position'
                            )
                          )
                        )
                      )
                    }" />

    <!-- Debug -->
    <xacro:if value="${enabled and debug}">
      <xacro:message text="[gazebo_ros2_control] enabled=true"/>
      <xacro:message text="${'[gazebo_ros2_control] controller=' + (controller if controller else '(empty)')}"/>
      <xacro:message text="${'[gazebo_ros2_control] yaml_files=' + (','.join(_yaml_list) if _yaml_list else '(empty)')}"/>
      <xacro:message text="${'[gazebo_ros2_control] type=' + (_ctrl_type if _ctrl_type else '(not found)')}"/>
      <xacro:message text="${'[gazebo_ros2_control] command_interfaces=' + (str(_cmd_ifs) if _cmd_ifs else '[]')}"/>
      <xacro:message text="${'[gazebo_ros2_control] interface_name=' + (_iface_name if _iface_name else '(none)')}"/>
      <xacro:message text="${'[gazebo_ros2_control] resolved_command_interface=' + _cmd_if}"/>
      <xacro:message text="${'[gazebo_ros2_control] joints_count=' + str(len(_joints))}"/>
      <xacro:message text="${'[gazebo_ros2_control] joints_head=' + (str(_joints[:6]) if _joints else '[]')}"/>
      <xacro:if value="${not _joints}">
        <xacro:warning text="[gazebo_ros2_control] joints list is empty. No ros2_control joints will be generated."/>
      </xacro:if>
      <xacro:if value="${not _yaml_list}">
        <xacro:warning text="[gazebo_ros2_control] yaml_files is empty. Plugin will not load any parameters."/>
      </xacro:if>
    </xacro:if>

    <!-- Emit <parameters> recursively -->
    <xacro:macro name="_emit_params" params="paths">
      <xacro:if value="${paths}">
        <parameters>${paths[0]}</parameters>
        <xacro:_emit_params paths="${paths[1:]}"/>
      </xacro:if>
    </xacro:macro>

    <!-- Emit joints recursively -->
    <xacro:macro name="_joint_block" params="joint_name cmd_if">
      <joint name="${joint_name}">
        <command_interface name="${cmd_if}"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <xacro:macro name="_joint_loop" params="joints cmd_if">
      <xacro:if value="${joints}">
        <xacro:_joint_block joint_name="${joints[0]}" cmd_if="${cmd_if}"/>
        <xacro:_joint_loop joints="${joints[1:]}" cmd_if="${cmd_if}"/>
      </xacro:if>
    </xacro:macro>

    <xacro:if value="${enabled}">

      <!-- REQUIRED: ros2_control block for gazebo_ros2_control -->
      <ros2_control name="${ros2_control_name}" type="system">
        <hardware>
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <xacro:_joint_loop joints="${_joints}" cmd_if="${_cmd_if}"/>
      </ros2_control>

      <!-- Gazebo Classic plugin -->
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <robot_param>${robot_param}</robot_param>
          <robot_param_node>${robot_param_node}</robot_param_node>
          <xacro:_emit_params paths="${_yaml_list}"/>
        </plugin>
      </gazebo>

    </xacro:if>

  </xacro:macro>

</robot>
