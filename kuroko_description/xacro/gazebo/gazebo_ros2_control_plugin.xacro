<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo Classic gazebo_ros2_control plugin helper.

    Params:
      - enabled: bool (typically ${gazebo})
      - yaml_files: semicolon-separated yaml list
      - robot_param: default robot_description
      - robot_param_node: default robot_state_publisher

    Notes:
      - Avoids xacro:for (not available in some ROS 2 Humble xacro setups).
      - Expands yaml_files into multiple <parameters> tags using recursion.
  -->

  <xacro:macro name="gazebo_ros2_control_plugin"
               params="enabled
                       yaml_files:=''
                       robot_param:=robot_description
                       robot_param_node:=robot_state_publisher
                       debug:=false">

    <!-- Split yaml_files -->
    <xacro:property name="_yaml_list"
                    value="${[s for s in yaml_files.split(';') if s.strip()]}" />

    <!-- Debug -->
    <xacro:if value="${enabled and debug}">
      <xacro:message text="[gazebo_ros2_control] enabled=true"/>
      <xacro:message text="${'[gazebo_ros2_control] yaml_files=' + (','.join(_yaml_list) if len(_yaml_list)>0 else '(empty)')}"/>
      <xacro:if value="${len(_yaml_list) == 0}">
        <xacro:warning text="[gazebo_ros2_control] yaml_files is empty. Plugin will not load any parameters."/>
      </xacro:if>
    </xacro:if>

    <!-- Recursively emit <parameters> -->
    <xacro:macro name="_emit_params" params="paths">
      <xacro:if value="${len(paths) > 0}">
        <parameters>${paths[0]}</parameters>
        <xacro:_emit_params paths="${paths[1:]}"/>
      </xacro:if>
    </xacro:macro>

    <xacro:if value="${enabled}">
      <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
          <robot_param>${robot_param}</robot_param>
          <robot_param_node>${robot_param_node}</robot_param_node>

          <xacro:_emit_params paths="${_yaml_list}"/>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
