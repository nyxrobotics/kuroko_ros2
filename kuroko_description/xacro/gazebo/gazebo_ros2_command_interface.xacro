<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo Classic ros2_control command interfaces (no PID).
    Provides:
      - set_effort_command_interfaces(joints, state_ifs)
      - set_velocity_command_interfaces(joints, state_ifs)
      - set_position_command_interfaces(joints, state_ifs)
      - gazebo_ros2_control_system(joints, command_if, state_ifs)
  -->

  <xacro:macro name="_state_interfaces_loop" params="ifs">
    <xacro:if value="${len(ifs) > 0}">
      <state_interface name="${ifs[0]}"/>
      <xacro:_state_interfaces_loop ifs="${ifs[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="_ros2_control_joint"
               params="joint_name command_if state_ifs:=${['position','velocity','effort']}">
    <joint name="${joint_name}">
      <command_interface name="${command_if}"/>
      <xacro:_state_interfaces_loop ifs="${state_ifs}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="set_effort_command_interfaces"
               params="joints state_ifs:=${['position','velocity','effort']}">
    <xacro:if value="${len(joints) > 0}">
      <xacro:_ros2_control_joint joint_name="${joints[0]}" command_if="effort" state_ifs="${state_ifs}"/>
      <xacro:set_effort_command_interfaces joints="${joints[1:]}" state_ifs="${state_ifs}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="set_velocity_command_interfaces"
               params="joints state_ifs:=${['position','velocity','effort']}">
    <xacro:if value="${len(joints) > 0}">
      <xacro:_ros2_control_joint joint_name="${joints[0]}" command_if="velocity" state_ifs="${state_ifs}"/>
      <xacro:set_velocity_command_interfaces joints="${joints[1:]}" state_ifs="${state_ifs}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="set_position_command_interfaces"
               params="joints state_ifs:=${['position','velocity','effort']}">
    <xacro:if value="${len(joints) > 0}">
      <xacro:_ros2_control_joint joint_name="${joints[0]}" command_if="position" state_ifs="${state_ifs}"/>
      <xacro:set_position_command_interfaces joints="${joints[1:]}" state_ifs="${state_ifs}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="gazebo_ros2_control_system"
               params="joints
                       command_if:='position'
                       state_ifs:=${['position','velocity','effort']}">
    <ros2_control name="GazeboSystem" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>

      <xacro:if value="${command_if == 'position'}">
        <xacro:set_position_command_interfaces joints="${joints}" state_ifs="${state_ifs}"/>
      </xacro:if>

      <xacro:if value="${command_if == 'velocity'}">
        <xacro:set_velocity_command_interfaces joints="${joints}" state_ifs="${state_ifs}"/>
      </xacro:if>

      <xacro:if value="${command_if == 'effort'}">
        <xacro:set_effort_command_interfaces joints="${joints}" state_ifs="${state_ifs}"/>
      </xacro:if>
    </ros2_control>
  </xacro:macro>

</robot>
