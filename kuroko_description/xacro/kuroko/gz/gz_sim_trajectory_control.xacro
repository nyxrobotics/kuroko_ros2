<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="ctrl_yaml"
                  value="$(find kuroko_description)/config/gz_trajectory_controller.yaml" />

  <!-- Load controller YAML -->
  <xacro:property name="ctrl_cfg"
                  value="${xacro.load_yaml(ctrl_yaml)}" />

  <!-- Extract joints list from YAML -->
  <xacro:property name="traj_joints"
                  value="${ctrl_cfg['joint_trajectory_controller']['ros__parameters']['joints']}" />

  <!-- Set one ros2_control <joint> block -->
  <xacro:macro name="gz_joint_hardware_interface" params="joint_name">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="gz_joint_hardware_interface_loop" params="joints">
    <xacro:if value="${len(joints) > 0}">
      <xacro:gz_joint_hardware_interface joint_name="${joints[0]}"/>
      <xacro:gz_joint_hardware_interface_loop joints="${joints[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="set_hardware_interface">
    <ros2_control name="GazeboSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:gz_joint_hardware_interface_loop joints="${traj_joints}"/>
    </ros2_control>
  </xacro:macro>

  <xacro:macro name="set_controller_interface">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${ctrl_yaml}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="gz_sim_trajectory_control">
    <xacro:set_hardware_interface/>
    <xacro:set_controller_interface/>
  </xacro:macro>

</robot>
