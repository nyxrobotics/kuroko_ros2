<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="${XACRO_DIR}/physics/default_gazebo_params.xacro"/>
  <xacro:macro name="leg_l_gazebo">
    <xacro:default_link_collision link_name="hip_l_roll_link" friction="0.01"/>
    <gazebo reference="hip_l_pitch_link">
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>0.01</mu1>
      <maxVel>10.0</maxVel>
      <minDepth>0.0001</minDepth>
      <maxContacts>6</maxContacts>
      <selfCollide>false</selfCollide>
      <dampingFactor>0</dampingFactor>
    </gazebo>
    <xacro:default_link_collision link_name="thigh_l_active_link" friction="0.0"/>
    <xacro:default_link_collision link_name="shin_l_active_link" friction="0.01"/>
    <xacro:default_link_collision link_name="thigh_l_middle_passive_link" friction="0.0"/>
    <xacro:default_link_collision link_name="thigh_l_rear_passive_link" friction="0.0"/>
    <xacro:default_link_collision link_name="knee_l_passive_link" friction="0.01"/>
    <xacro:default_link_collision link_name="shin_l_front_passive_link" friction="0.0"/>
    <xacro:default_link_collision link_name="shin_l_rear_passive_link" friction="0.0"/>
    <xacro:default_link_collision link_name="ankle_l_pitch_passive_link" friction="0.01"/>
    <xacro:default_link_collision link_name="ankle_l_roll_link" friction="0.0"/>
    <gazebo reference="ankle_l_yaw_link">
      <kp>2000000.0</kp>
      <kd>200.0</kd>
      <mu1>1.0</mu1>
      <maxVel>1.0</maxVel>
      <minDepth>0.0001</minDepth>
      <maxContacts>10</maxContacts>
      <selfCollide>false</selfCollide>
      <dampingFactor>0.0</dampingFactor>
    </gazebo>
    <xacro:implicit_damping_joint joint_name="hip_l_roll"/>
    <xacro:implicit_damping_joint joint_name="hip_l_pitch"/>
    <xacro:implicit_damping_joint joint_name="thigh_l_active"/>
    <xacro:implicit_damping_joint joint_name="shin_l_active"/>
    <xacro:implicit_damping_joint joint_name="ankle_l_roll"/>
    <xacro:implicit_damping_joint joint_name="ankle_l_yaw"/>
  </xacro:macro>
</robot>
