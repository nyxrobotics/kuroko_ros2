<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="${XACRO_DIR}/physics/default_gazebo_params.xacro"/>
  <xacro:macro name="body_gazebo">
    <xacro:default_link_collision link_name="chest_link" friction="0.4"/>
    <xacro:default_link_collision link_name="waist_link" friction="0.1"/>
    <xacro:implicit_damping_joint joint_name="chest"/>
  </xacro:macro>
</robot>
