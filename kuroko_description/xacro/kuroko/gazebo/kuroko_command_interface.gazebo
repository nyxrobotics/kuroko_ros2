<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Kuroko-specific ros2_control interface definitions (Gazebo Classic) -->
  <xacro:include filename="${XACRO_DIR}/gazebo/gazebo_ros2_command_interface.xacro"/>
  <xacro:include filename="${XACRO_DIR}/gazebo/gazebo_ros2_control_plugin.xacro"/>

  <xacro:property name="kuroko_joints" value="${[
    'chest',
    'shoulder_r_pitch',
    'shoulder_r_roll',
    'elbow_r_front',
    'elbow_r_rear',
    'shoulder_l_pitch',
    'shoulder_l_roll',
    'elbow_l_front',
    'elbow_l_rear',
    'hip_r_roll',
    'hip_r_pitch',
    'thigh_r_active',
    'shin_r_active',
    'ankle_r_roll',
    'ankle_r_yaw',
    'hip_l_roll',
    'hip_l_pitch',
    'thigh_l_active',
    'shin_l_active',
    'ankle_l_roll',
    'ankle_l_yaw'
  ]}"/>

  <xacro:macro name="kuroko_command_interface_position" params="controller_yaml:='' state_ifs:=${['position','velocity']}">
    <xacro:gazebo_ros2_control_system joints="${kuroko_joints}" command_if="position" state_ifs="${state_ifs}"/>
    <xacro:gazebo_ros2_control_plugin controller_yaml="${controller_yaml}"/>
  </xacro:macro>

  <xacro:macro name="kuroko_command_interface_effort" params="controller_yaml:='' state_ifs:=${['position','velocity']}">
    <xacro:gazebo_ros2_control_system joints="${kuroko_joints}" command_if="effort" state_ifs="${state_ifs}"/>
    <xacro:gazebo_ros2_control_plugin controller_yaml="${controller_yaml}"/>
  </xacro:macro>

</robot>