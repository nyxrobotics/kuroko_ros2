<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="${XACRO_DIR}/gazebo/gazebo_ros2_control_system.xacro"/>
  <xacro:include filename="${XACRO_DIR}/gazebo/gazebo_ros2_transmission.xacro"/>

  <xacro:property name="kuroko_joints" value="${[
    'chest',
    'shoulder_r_pitch',
    'shoulder_r_roll',
    'elbow_r_front',
    'elbow_r_rear',
    'shoulder_l_pitch',
    'shoulder_l_roll',
    'elbow_l_front',
    'elbow_l_rear',
    'hip_r_roll',
    'hip_r_pitch',
    'thigh_r_active',
    'shin_r_active',
    'ankle_r_roll',
    'ankle_r_yaw',
    'hip_l_roll',
    'hip_l_pitch',
    'thigh_l_active',
    'shin_l_active',
    'ankle_l_roll',
    'ankle_l_yaw'
  ]}"/>

  <!-- Effort control (ros2_control joint interfaces + transmissions) -->
  <xacro:macro name="kuroko_transmission_effort" params="controller_yaml:=''">
    <xacro:gazebo_ros2_control_system/>
    <xacro:kuroko_gazebo_ros2_control_plugin parameters="${controller_yaml}"/>
    <xacro:set_effort_interfaces joints="${kuroko_joints}"/>
  </xacro:macro>

  <!-- Position control (ros2_control joint interfaces + transmissions) -->
  <xacro:macro name="kuroko_transmission_position" params="controller_yaml:=''">
    <xacro:gazebo_ros2_control_system/>
    <xacro:kuroko_gazebo_ros2_control_plugin parameters="${controller_yaml}"/>
    <xacro:set_position_interfaces joints="${kuroko_joints}"/>
  </xacro:macro>
</robot>