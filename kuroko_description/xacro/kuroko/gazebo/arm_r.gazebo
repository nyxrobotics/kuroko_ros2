<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="${XACRO_DIR}/physics/default_gazebo_params.xacro"/>
  <xacro:macro name="arm_r_gazebo">
    <xacro:default_link_collision link_name="shoulder_r_pitch_link" friction="0.01"/>
    <xacro:default_link_collision link_name="shoulder_r_roll_link" friction="0.01"/>
    <xacro:default_link_collision link_name="elbow_r_front_link" friction="0.01"/>
    <xacro:default_link_collision link_name="elbow_r_rear_link" friction="0.01"/>
    <xacro:implicit_damping_joint joint_name="shoulder_r_pitch"/>
    <xacro:implicit_damping_joint joint_name="shoulder_r_roll"/>
    <xacro:implicit_damping_joint joint_name="elbow_r_front"/>
    <xacro:implicit_damping_joint joint_name="elbow_r_rear"/>
  </xacro:macro>
</robot>
