<?xml version="1.0"?>
<package format="3">
  <name>kuroko_kinematics</name>
  <version>0.0.0</version>
  <description>Kuroko kinematics library (forward/inverse kinematics) ported to ROS 2.</description>

  <maintainer email="nyxroboticss@gmail.com">nyxrobotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <build_depend>eigen</build_depend>

  <exec_depend>eigen3_cmake_module</exec_depend>
  <exec_depend>eigen</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
